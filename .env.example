# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# SerpAPI（Google Flights + Google Hotels）
# 申请：https://serpapi.com/manage-api-key   免费额度 250 次/月
SERPAPI_KEY=

# 高德开放平台 Key —— 类型必须是「Web 服务 API」，JS/Android/iOS 类型会报 10001
# 申请：https://console.amap.com/dev/key/app
AMAP_KEY=

# ---- LLM ----
# 只用于把排好的行程翻译成一段说明；分天/排序/算时间全是确定性算法，不经过模型。
#
# openai_compatible 覆盖 DeepSeek / 阿里云百炼 / 智谱 / Kimi / 火山方舟 / 硅基流动 /
# OpenAI 等，换供应商只改下面三行：
#   DeepSeek  https://api.deepseek.com                              deepseek-v4-flash
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
#   Kimi      https://api.moonshot.cn/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=

# Gemini 分支用（LLM_PROVIDER=gemini 时）。
# 注意：Google 按服务端 IP 归属地做策略拒绝，中国大陆直连会返回
# FAILED_PRECONDITION: User location is not supported，需要挂支持地区的代理。
GOOGLE_API_KEY=

# 本服务对外的 API Key（客户端需在 X-API-Key 头里带上）；留空则关闭鉴权（仅限本地开发）
APP_API_KEY=

# 可选覆盖项
# 完全不接模型时打开：行程说明改由确定性模板生成，内容与 LLM 路径一致
# LLM_ENABLED=false
# LOG_LEVEL=INFO
# LOG_JSON=true

# ---- 长期记忆（记忆与追问文档 §5 / §6）----
# 哪一份记忆由请求头 X-Profile-Id 指定（方案 A：客户端自己生成 UUID）。
# ⚠️ 它**不是安全边界**：可猜、可冒充，鉴权仍由 X-API-Key 负责。
#    正因为可猜，记忆里绝不能存姓名、证件、支付信息。
# 关掉它：解析不查偏好、景点打分不做去过降权，行为退回没有记忆时的样子。
# MEMORY_ENABLED=true
# SQLite 单文件，按需创建。上多副本时和 checkpointer 一起迁 Postgres。
# MEMORY_DB_PATH=data/memory.db

# ---- ReAct 参数收集（Flight ReAct Agent 设计文档 §2）----
# 关掉则 /trips/chat 退回单次规则抽取（仍可用，只是不如模型自然）
# REACT_ENABLED=true
# ReAct 循环的硬上限，到顶就带着已收集到的参数收尾，不继续烧 token
# REACT_MAX_STEPS=6
# intake 单次模型调用的超时。**不能沿用全局 30s**：每次都带工具说明 + 完整
# 对话历史，实测常在 25~60 秒，超时的表现是静默退回规则解析
# INTAKE_LLM_TIMEOUT_S=120

# ---- 模拟模式（docs/architecture/serpapi-usage-and-mocking.md）----
# 两个都打开 = 完全离线：不联网、不需要任何 key 也能跑通整条规划链。
# 模拟层仍走 TTL 缓存并如实记配额，所以"若走真接口会烧几次"在模拟环境里依然准确。
# SERPAPI_MOCK=false      # 机票 + 酒店
# AMAP_MOCK=false         # 景点 + 路径 + 逆地理编码
# MOCK_SEED=20260910      # 留空则票价/房价每次不同；给定则完全可复现

# ---- 自主规划 Agent ----
# 规划全部交给 LLM：查什么、查几次、怎么排都由它决定。
# ⚠️ 代价是没有任何代码兜底——可能排出"18:00 去 17:00 关门的景点"、
#    也可能赶不上返程航班。这是选择这条路径时接受的取舍。
# AGENT_MAX_STEPS=24            自主循环步数上限
# AGENT_SERPAPI_BUDGET=6        单次规划最多烧几次 SerpAPI（免费额度 250/月）
# AGENT_LLM_TIMEOUT_S=180       带十几个工具 schema 的请求，30s 不够
