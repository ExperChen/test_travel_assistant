# Copy this file to .env in the project root and fill in real values.
# See README.md section 4 ("Required Environment Variables") for details on each.

SERPAPI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.5-flash

# Optional
ATTRACTION_TOOL_DEBUG=0
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=flight-agent

# Optional: gates POST /api/v1/agent/generate_itinerary behind an X-API-Key header.
# Left unset, the endpoint has no auth. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_RATE_LIMIT=20/hour
